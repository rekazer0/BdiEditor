{
  "name": "bdi-edit",
  "private": true,
  "version": "1.6.59",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/verify-bundle-size.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run verify:samples -- public/default-template.bds && npm run verify:layers && npm run verify:states && npm run verify:layout && npm run verify:actions && npm run verify:preview-lists && npm run verify:candidate-style && npm run verify:inspector-groups && npm run verify:particle-inspector && npm run verify:mobile-share && npm run verify:sources && npm run verify:source-editor && npm run verify:bda-import && npm run verify:bda-editor && npm run verify:bda-overview && npm run verify:bda-official-parser && npm run verify:bda-official-preview && npm run verify:logging && npm run verify:safe-area && npm run verify:mixed-coordinate && npm run verify:preview-slicing && npm run verify:panel-copy && npm run verify:unsaved",
    "deploy:cloudbase": "tcb app deploy",
    "version:feature": "node scripts/bump-version.mjs feature",
    "version:bugfix": "node scripts/bump-version.mjs bugfix",
    "verify:samples": "node scripts/verify-samples.ts",
    "verify:layers": "node scripts/verify-layers.ts",
    "verify:states": "node scripts/verify-states.ts",
    "verify:layout": "node scripts/verify-layout.ts",
    "verify:actions": "node scripts/verify-actions.ts",
    "verify:preview-lists": "node scripts/verify-preview-lists.ts",
    "verify:candidate-style": "node scripts/verify-candidate-style.ts",
    "verify:inspector-groups": "node scripts/verify-inspector-groups.ts",
    "verify:particle-inspector": "node scripts/verify-particle-inspector.ts",
    "verify:mobile-share": "node scripts/verify-mobile-share.ts",
    "verify:sources": "node scripts/verify-source-workspace.ts",
    "verify:source-editor": "node scripts/verify-source-editor.ts",
    "verify:source-editor:browser": "node scripts/verify-source-editor-browser.mjs",
    "verify:bda-import": "node scripts/verify-bda-import.ts",
    "verify:bda-editor": "node scripts/verify-bda-editor.ts",
    "verify:bda-overview": "node scripts/verify-bda-overview-groups.ts",
    "verify:bda-official-parser": "node scripts/verify-bda-official-parser.ts",
    "verify:bda-official-preview": "node scripts/verify-bda-official-preview.ts",
    "verify:logging": "node scripts/verify-client-logging.ts",
    "verify:safe-area": "node scripts/verify-safe-area.ts",
    "verify:mixed-coordinate": "node scripts/verify-mixed-coordinate.ts",
    "verify:preview-slicing": "node scripts/verify-preview-slicing.ts",
    "verify:panel-copy": "node scripts/verify-panel-copy.ts",
    "verify:unsaved": "node scripts/verify-unsaved.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@cloudbase/cli": "^3.8.1",
    "@tauri-apps/cli": "^2.8.0",
    "puppeteer-core": "^25.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
