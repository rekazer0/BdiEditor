{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BDI 皮肤编辑器",
  "version": "0.1.0",
  "identifier": "io.github.rekazer0.bdiedit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self'; script-src 'self'"
    },
    "windows": [
      {
        "title": "BDI 皮肤编辑器",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "百度 iOS 输入法皮肤可视化编辑器",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": ["bdi"],
        "name": "百度输入法 iOS 皮肤",
        "mimeType": "application/octet-stream",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "io.github.rekazer0.bdiedit.bdi",
          "conformsTo": ["public.data"]
        }
      },
      {
        "ext": ["bds"],
        "name": "百度输入法 Android 皮肤",
        "mimeType": "application/octet-stream",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "io.github.rekazer0.bdiedit.bds",
          "conformsTo": ["public.data"]
        }
      }
    ]
  }
}
